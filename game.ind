chhap("====================================")
chhap("       NUMBER GUESSING GAME")
chhap("====================================")

maano secret = number_dalao("Set the secret number (1-10): ")
maano attempts = 0

jabtak sahi {
    maano guess = number_dalao("Guess the number (1-10): ")
    attempts += 1

    agar guess == secret {
        chhap("")
        chhap("🎉 Correct!")
        chhap("You guessed it in", attempts, "attempts.")
        roko
    } nahito_agar guess < secret {
        chhap("Too low! Try again.")
    } nahito {
        chhap("Too high! Try again.")
    }
}

chhap("")
chhap("Thanks for playing!")
